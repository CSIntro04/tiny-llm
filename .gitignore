# 数据（大文件不进 git）
data/raw/
data/processed/*.bin
data/processed_char/*.bin
data/processed_char/*.log

# checkpoint
runs/*/ckpt*.pt
runs/smoke_*/
runs/overfit_*/

# Python
__pycache__/
*.pyc
*.egg-info/

# 工具
.ipynb_checkpoints/
.gradio/
.env
.vscode/

# 打包的训练结果
*.tar.gz

# 导出的仅权重 checkpoint（分发用，不进 git）
release/

# 答辩 PPT 由 docs/slides/build_slides.py 生成，不进 git（模板 docs/slides/模板.pptx 进 git）
docs/slides/*.pptx
!docs/slides/模板.pptx

# 前端依赖（app/web/dist 构建产物要提交，演示机不用装 Node）
app/web/node_modules/
